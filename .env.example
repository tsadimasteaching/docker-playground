# Copy this file to .env and adjust the values:
#   cp .env.example .env
#
# docker compose reads .env automatically and substitutes ${VARIABLES} in compose.yaml.
# .env is in .gitignore — never commit real passwords.

# ---- PostgreSQL (used by the db AND the backend service) ----
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me

# ---- Published host ports ----
BACKEND_PORT=8080
FRONTEND_PORT=8081
